<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCancelledPatientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Patient Name"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCancelledStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Cancelled"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtCancelledPatientInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Age: 25  •  Female"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E2E8F0" />

        <TextView
            android:id="@+id/txtCancelledDoctorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dr. John Smith"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtCancelledSpecialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="General Dentist"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCancelledDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Date: 2026-08-10"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCancelledTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Time: 09:30 AM"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCancelledType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Type: Consultation"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtCancelledPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Phone: 09xxxxxxxxx"
            android:textColor="#475569"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FEF2F2">

            <TextView
                android:id="@+id/txtCancellationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancellation Information"
                android:textColor="#991B1B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCancellationReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Reason: Patient requested cancellation"
                android:textColor="#7F1D1D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtCancelledAt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cancelled on: 10 Aug 2026, 08:30 AM"
                android:textColor="#991B1B"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtOriginalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Original status: Confirmed"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>