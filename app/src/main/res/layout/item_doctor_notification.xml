<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtDoctorNotificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appointment Cancelled"
            android:textColor="#DC2626"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDoctorNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Patient cancelled the appointment."
            android:textColor="#334155"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtDoctorNotificationItemDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="10 Aug 2026, 9:30 AM"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>