<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/layoutDoctorInfo"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/imgDoctorPhoto"
            android:layout_marginEnd="12dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtLookingDoctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Looking For Your Desire&#10;Specialist Doctor?"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <TextView
                android:id="@+id/txtDoctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Dr. Emily Carter"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0"/>


            <TextView
                android:id="@+id/txtDoctorSpeciality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="Orthodontist&#10;10+ Years Experience"
                android:textSize="14sp"
                android:textColor="#666666"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDoctor"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="5dp"
                android:text="View Profile"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:background="@drawable/button_gradient"
                app:backgroundTint="@null"
                app:cornerRadius="20dp"/>


        </LinearLayout>

        <ImageView
            android:id="@+id/imgDoctorPhoto"
            android:layout_width="120dp"
            android:layout_height="170dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:adjustViewBounds="true"
            android:src="@drawable/emily_carter"
            android:scaleType="centerCrop" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>